# ============================================================
# Apache Server Hardening & Security Configuration
# ============================================================

# Prevent directory indexing/browsing
Options -Indexes

# Protect sensitive configuration, environment, and database files
<FilesMatch "^(\.env.*|\.git.*|\.ht.*|.*\.sql|.*\.log|composer\.(json|lock)|phpunit\.xml|\.user\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# PHP Security Directives (Production Hardening)
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite "Lax"
</IfModule>

# URL Rewriting & Friendly Shortcuts (Domain-Agnostic / Dynamic Path)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect requests with trailing text on loginadmin.php
    RewriteCond %{REQUEST_URI} loginadmin\.php.+ [NC]
    RewriteRule ^.*$ loginadmin.php [R=302,L]

    # Friendly shortcuts (relative to current directory, works on any domain or folder)
    RewriteRule ^admin/?$ loginadmin.php [R=302,L]
    RewriteRule ^admin-page/?$ loginadmin.php [R=302,L]
    RewriteRule ^login/?$ loginadmin.php [R=302,L]
</IfModule>
