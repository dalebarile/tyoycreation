{
    "name": "tyoy-creation/qes",
    "description": "Tyoy Creation QES - Event Booking System",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Qes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Qes\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration"
    },
    "config": {
        "sort-packages": true
    }
}
